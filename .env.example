# HTTP backend: server-only and read at request time. No trailing /api needed.
API_BASE_URL=http://localhost:3001
# On deployment set API_BASE_URL to the actual backend URL, never localhost.
# Explicit opt-in ONLY for testing a production build against a local backend:
# ALLOW_LOCAL_API_IN_PRODUCTION=1
API_TIMEOUT_MS=30000

# WebSocket translation service: must be wss:// on an HTTPS deployment.
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
