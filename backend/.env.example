DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/authDB?retryWrites=true&w=majority"
JWT_SECRET="change-me-generate-a-strong-secret"
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@voxlate.com"
ADMIN_PASSWORD="change-me-min-8-chars"
PORT=3001
NEXT_PUBLIC_FRONTEND_URL="http://localhost:3002"

GOOGLE_CLIENT_ID="your-google-client-id"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

RESEND_API_KEY="your-resend-api-key"
RESEND_FROM_EMAIL="Voxlate <no-reply@voxlatesn.in>"


# Host-only cookies work through the frontend /api proxy and preview deployments.
# Set only if intentionally sharing sessions across subdomains:
# SESSION_COOKIE_DOMAIN=.voxlatesn.in
# Exact allowed frontend origins (comma separated); legacy NEXT_PUBLIC_FRONTEND_URL is supported.
FRONTEND_URL="http://localhost:3002"
