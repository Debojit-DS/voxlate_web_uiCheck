{
  "name": "voxlate-waitlist",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3002",
    "dev:backend": "npm --prefix backend run dev",
    "build": "next build",
    "build:backend": "npm --prefix backend run build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "npm run test:integration",
    "test:integration": "node --test tests/*.test.mjs",
    "test:backend": "npm --prefix backend run test:integration",
    "test:all": "npm run test:integration && npm --prefix backend run test:integration",
    "db:generate": "npm --prefix backend run db:generate",
    "db:push": "npm --prefix backend run db:push",
    "db:seed": "npm --prefix backend run db:seed",
    "db:studio": "npm --prefix backend run db:studio"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.27.0",
    "mongodb": "^7.5.0",
    "next": "^16.2.11",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.80.0",
    "resend": "^6.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.19.0",
    "eslint-config-next": "^16.2.11",
    "postcss": "^8.4.49",
    "prettier": "^3.7.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.2"
  }
}
